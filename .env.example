# Admin panel (/admin): login password, and an optional separate key for signing sessions
ADMIN_PASSWORD=change-me
# ADMIN_SECRET=long-random-string

# Where setup requests and providers are stored (JSON file). Default: ./data/db.json
# DATA_FILE=./data/db.json

# Optional: lets an admin export ALL leads via /api/solset/export?token=...
# ADMIN_TOKEN=change-me

# Optional: Solset has no public API. If you relay leads through Zoho/Zapier/Make
# (Solset supports Zoho), set the inbound webhook here to enable "Push to Solset".
# SOLSET_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx/yyy

# Solset AI design API (backend). Solset has no public API yet — request access at
# https://solset.ai/contact/enterprise, then fill these in. Until set, designs are saved locally.
# SOLSET_API_URL=https://api.solset.ai
# SOLSET_API_KEY=
# SOLSET_DESIGN_PATH=/v1/designs
# SOLSET_WORKSPACE_ID=
